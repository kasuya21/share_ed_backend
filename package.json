    "cloudinary": "^2.10.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "node-cron": "^4.3.0",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "openapi-to-postmanv2": "^6.3.0",
    "prisma": "^7.4.2",
    "swagger-autogen": "^2.23.7"
  }
