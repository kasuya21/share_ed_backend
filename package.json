    "k6:feed": "k6 run k6/scenarios/feed.js",
    "k6:likes": "k6 run k6/scenarios/likes.js",
    "k6:rewards": "k6 run k6/scenarios/rewards.js",
    "k6:notifications": "k6 run k6/scenarios/notifications.js",
    "k6:posts": "k6 run k6/scenarios/posts-upload.js",
    "k6:mixed": "k6 run k6/scenarios/mixed.js"
  },
  "keywords": [
    "this",
    "is",
    "server",
    "for",
    "share",
    "ed"
  ],
