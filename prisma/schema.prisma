generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum EducationLevel {
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  UNIVERSITY
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

enum ItemType {
  THEME
  FRAME
}

enum NotificationTypeCode {
  // Social
  NEW_FOLLOWER
  NEW_LIKE
  LIKE
  NEW_COMMENT
  NEW_POST
  // Bookmark
  BOOKMARK_REMOVED
  // Post moderation
  POST_SUSPENDED
  POST_RESTORED
  POST_REMOVED
  POST_REPORTED
  // Quest / Milestone
  QUEST_COMPLETED
  // Account management
  ACCOUNT_BANNED
  ACCOUNT_UNBANNED
}

enum PostStatus {
  DRAFT
  ACTIVE
  DELETED
  UNACTIVED
}

enum UploadSessionStatus {
  PENDING
  COMMITTED
  EXPIRED
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @map("user_id")

  email    String @unique
  username String @unique

  profile_image String?
  bio           String?

  role   Role       @default(MEMBER)
  status UserStatus @default(ACTIVE)

  education_level EducationLevel?
  social_links    Json?
  wallpaper       String?
  profile_banner  String?

  is_onboarded Boolean @default(false)

  nickname   String?
  location   String?
  occupation String?

  current_theme_id String?
  current_frame_id String?

  current_theme RewardItem? @relation("UserTheme", fields: [current_theme_id], references: [id])
  current_frame RewardItem? @relation("UserFrame", fields: [current_frame_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  posts     Post[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  followers Follow[] @relation("followers")
  following Follow[] @relation("following")

  notifications        Notification[] @relation("NotificationRecipient")
  notification_actions Notification[] @relation("NotificationActor")

  unlocked_items    UserUnlockedItem[]
  user_achievements UserAchievement[]
  views             PostView[]
  reports           Report[]
  upload_sessions   UploadSession[]

  @@index([username])
  @@index([email])
  @@index([role])
  @@map("users")
}

//////////////////////////////////////////////////////
// PRIVILEGED ACTION AUDIT
//////////////////////////////////////////////////////

model AdminSecurityAudit {
  id String @id @default(uuid()) @map("audit_id")

  actor_id       String
  target_user_id String
  action         String
  old_value      String?
  new_value      String?
  request_id     String?
  ip_address     String?

  created_at DateTime @default(now())

  @@index([actor_id, created_at])
  @@index([target_user_id, created_at])
  @@map("admin_security_audits")
}

//////////////////////////////////////////////////////
// POSTS
//////////////////////////////////////////////////////

model Post {
  id String @id @default(uuid()) @map("post_id")

  title   String
  summary String
  content String

  post_status PostStatus @default(DRAFT)
  deleted_by String?
  deleted_from_status PostStatus?

  education_level EducationLevel

  view_count     Int @default(0)
  like_count     Int @default(0)
  comment_count  Int @default(0)
  bookmark_count Int @default(0)

  author_id String
  author    User   @relation(fields: [author_id], references: [id])

  category_id String?
  category    Category? @relation(fields: [category_id], references: [id])

  cover_image     String?
  idempotency_key String?

  media           PostMedia[]
  comments        Comment[]
  likes           Like[]
  bookmarks       Bookmark[]
  tags            PostTag[]
  views           PostView[]
  reports         Report[]
  notifications   Notification[]
  upload_sessions UploadSession[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@unique([author_id, idempotency_key])
  @@index([author_id])
  @@index([education_level])
  @@index([created_at])
  @@index([like_count])
  @@index([view_count])
  @@index([post_status, created_at])
  @@index([post_status, view_count])
  @@map("posts")
}

model UploadSession {
  id              String              @id @default(uuid()) @map("upload_session_id")
  user_id         String
  user            User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_id         String?
  post            Post?               @relation(fields: [post_id], references: [id], onDelete: SetNull)
  status          UploadSessionStatus @default(PENDING)
  requested_types Json
  verified_assets Json?
  expires_at      DateTime
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  @@index([user_id, status])
  @@index([status, expires_at])
  @@map("upload_sessions")
}

//////////////////////////////////////////////////////
// COMMENTS
//////////////////////////////////////////////////////

model Comment {
  id String @id @default(uuid()) @map("comment_id")

  content String

  user_id String
  post_id String

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([post_id])
  @@index([user_id])
  @@map("comments")
}

//////////////////////////////////////////////////////
// LIKES
//////////////////////////////////////////////////////

model Like {
  id String @id @default(uuid()) @map("like_id")

  user_id String
  post_id String

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
  @@map("likes")
}

//////////////////////////////////////////////////////
// BOOKMARKS
//////////////////////////////////////////////////////

model Bookmark {
  id String @id @default(uuid()) @map("bookmark_id")

  user_id String
  post_id String

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
  @@map("bookmarks")
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id String @id @default(uuid()) @map("category_id")

  name String @unique

  posts Post[]

  @@map("categories")
}

//////////////////////////////////////////////////////
// TAG
//////////////////////////////////////////////////////

model Tag {
  id String @id @default(uuid()) @map("tag_id")

  tag_name String @unique

  posts PostTag[]

  @@map("tags")
}

//////////////////////////////////////////////////////
// POST TAG
//////////////////////////////////////////////////////

model PostTag {
  id String @id @default(uuid())

  post_id String
  tag_id  String

  post Post @relation(fields: [post_id], references: [id])
  tag  Tag  @relation(fields: [tag_id], references: [id])

  @@unique([post_id, tag_id])
  @@map("post_tags")
}

//////////////////////////////////////////////////////
// POST MEDIA
//////////////////////////////////////////////////////

model PostMedia {
  id String @id @default(uuid()) @map("post_media_id")

  media_url     String
  media_type    MediaType
  original_name String?

  post_id String
  post    Post   @relation(fields: [post_id], references: [id])

  @@map("post_media")
}

//////////////////////////////////////////////////////
// FOLLOW
//////////////////////////////////////////////////////

model Follow {
  id String @id @default(uuid())

  follower_id  String
  following_id String

  follower  User @relation("followers", fields: [follower_id], references: [id])
  following User @relation("following", fields: [following_id], references: [id])

  created_at DateTime @default(now())

  @@unique([follower_id, following_id])
  @@index([follower_id])
  @@index([following_id])
  @@map("follows")
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

model Notification {
  id String @id @default(uuid()) @map("notification_id")

  user_id String
  type    NotificationTypeCode @default(NEW_POST)

  message String

  post_id  String?
  actor_id String?
  is_read  Boolean @default(false)

  user  User  @relation("NotificationRecipient", fields: [user_id], references: [id])
  actor User? @relation("NotificationActor", fields: [actor_id], references: [id], onDelete: SetNull)
  post  Post? @relation(fields: [post_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([user_id, created_at])
  @@index([actor_id])
  @@index([user_id, actor_id, post_id, type])
  @@index([is_read])
  @@map("notifications")
}

//////////////////////////////////////////////////////
// REWARDS & COSMETICS
//////////////////////////////////////////////////////

model RewardItem {
  id String @id @map("item_id")

  item_name String
  item_type ItemType

  image_url String?

  metadata Json?

  is_active Boolean @default(true)

  unlocked_by  UserUnlockedItem[]
  achievements Achievement[]

  theme_users User[] @relation("UserTheme")
  frame_users User[] @relation("UserFrame")

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("reward_items")
}

model UserUnlockedItem {
  id String @id @default(uuid())

  user_id String
  item_id String

  user User       @relation(fields: [user_id], references: [id])
  item RewardItem @relation(fields: [item_id], references: [id])

  unlocked_at DateTime @default(now())

  @@unique([user_id, item_id])
  @@map("user_unlocked_items")
}

//////////////////////////////////////////////////////
// ACHIEVEMENTS
//////////////////////////////////////////////////////

model Achievement {
  id String @id @default(uuid())

  title       String
  description String

  target_value     Int
  achievement_type String

  reward_item_id String?
  reward_item    RewardItem? @relation(fields: [reward_item_id], references: [id])

  user_achievements UserAchievement[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("achievements")
}

model UserAchievement {
  id String @id @default(uuid())

  user_id        String
  achievement_id String

  current_progress Int     @default(0)
  is_completed     Boolean @default(false)

  completed_at DateTime?
  claimed_at   DateTime?

  user        User        @relation(fields: [user_id], references: [id])
  achievement Achievement @relation(fields: [achievement_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, achievement_id])
  @@map("user_achievements")
}

//////////////////////////////////////////////////////
// POST VIEWS
//////////////////////////////////////////////////////

model PostView {
  id String @id @default(uuid()) @map("view_id")

  user_id String
  post_id String

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  viewed_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([viewed_at, post_id])
  @@map("post_views")
}

//////////////////////////////////////////////////////
// REPORTS
//////////////////////////////////////////////////////

model Report {
  id String @id @default(uuid()) @map("report_id")

  reason String

  user_id String
  post_id String

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@map("reports")
}
