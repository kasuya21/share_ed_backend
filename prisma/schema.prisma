generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @map("user_id")
  email               String                @unique
  username            String                @unique
  profile_image       String?
  bio                 String?
  role                Role                  @default(MEMBER)
  status              UserStatus            @default(ACTIVE)
  education_level     EducationLevel?
  current_theme_id    String?
  current_frame_id    String?
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  age                 Int?
  is_onboarded        Boolean               @default(false)
  social_links        Json?
  nickname            String?
  location            String?
  occupation          String?
  profile_banner      String?
  wallpaper           String?
  bookmarks           Bookmark[]
  comments            Comment[]
  followers           Follow[]              @relation("followers")
  following           Follow[]              @relation("following")
  likes               Like[]
  notifications       Notification[]
  views               PostView[]
  posts               Post[]
  reports             reports[]
  user_milestones     user_milestones[]
  user_unlocked_items user_unlocked_items[]
  current_frame       reward_items?         @relation("UserFrame", fields: [current_frame_id], references: [item_id])
  current_theme       reward_items?         @relation("UserTheme", fields: [current_theme_id], references: [item_id])

  @@index([email])
  @@index([role])
  @@index([username])
  @@map("users")
}

model Post {
  id              String         @id @default(uuid()) @map("post_id")
  title           String
  summary         String
  content         String
  post_status     PostStatus     @default(DRAFT)
  education_level EducationLevel
  view_count      Int            @default(0)
  like_count      Int            @default(0)
  comment_count   Int            @default(0)
  bookmark_count  Int            @default(0)
  author_id       String
  category_id     String?
  created_at      DateTime       @default(now())
  updated_at      DateTime
  cover_image     String?
  bookmarks       Bookmark[]
  comments        Comment[]
  likes           Like[]
  media           PostMedia[]
  tags            PostTag[]
  views           PostView[]
  author          User           @relation(fields: [author_id], references: [id])
  category        Category?      @relation(fields: [category_id], references: [id])
  reports         reports[]

  @@index([author_id])
  @@index([created_at])
  @@index([education_level])
  @@index([like_count])
  @@index([view_count])
  @@map("posts")
}

model Comment {
  id         String   @id @default(uuid()) @map("comment_id")
  content    String
  user_id    String
  post_id    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@index([user_id])
  @@map("comments")
}

model Like {
  id         String   @id @default(uuid()) @map("like_id")
  user_id    String
  post_id    String
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
  @@map("likes")
}

model Bookmark {
  id         String   @id @default(uuid()) @map("bookmark_id")
  user_id    String
  post_id    String
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
  @@map("bookmarks")
}

model Category {
  id    String @id @default(uuid()) @map("category_id")
  name  String @unique
  posts Post[]

  @@map("categories")
}

model Tag {
  id       String    @id @default(uuid()) @map("tag_id")
  tag_name String    @unique
  posts    PostTag[]

  @@map("tags")
}

model PostTag {
  id      String @id @default(uuid())
  post_id String
  tag_id  String
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tag_id], references: [id])

  @@unique([post_id, tag_id])
  @@map("post_tags")
}

model PostMedia {
  id         String    @id @default(uuid()) @map("post_media_id")
  media_url  String
  media_type MediaType
  post_id    String
  post       Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@map("post_media")
}

model Follow {
  id           String   @id @default(uuid())
  follower_id  String
  following_id String
  created_at   DateTime @default(now())
  follower     User     @relation("followers", fields: [follower_id], references: [id], onDelete: Cascade)
  following    User     @relation("following", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id])
  @@index([follower_id])
  @@index([following_id])
  @@map("follows")
}

model Notification {
  id         String               @id @default(uuid()) @map("notification_id")
  user_id    String
  type       NotificationTypeCode
  message    String
  is_read    Boolean              @default(false)
  created_at DateTime             @default(now())
  user       User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([is_read])
  @@index([user_id])
  @@map("notifications")
}

model PostView {
  id        String   @id @default(uuid()) @map("view_id")
  user_id   String
  post_id   String
  viewed_at DateTime @default(now())
  post      Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@map("post_views")
}

model milestones {
  id              String            @id
  title           String
  description     String
  target_value    Int
  milestone_type  String
  reward_item_id  String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @default(now())
  reward_items    reward_items?     @relation(fields: [reward_item_id], references: [item_id])
  user_milestones user_milestones[]
}

model reports {
  report_id  String   @id
  reason     String
  user_id    String
  post_id    String
  created_at DateTime @default(now())
  posts      Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  users      User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, post_id])
}

model reward_items {
  item_id             String                @id
  item_name           String
  item_type           ItemType
  image_url           String?
  metadata            Json?
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @default(now())
  milestones          milestones[]
  user_unlocked_items user_unlocked_items[]
  frame_users         User[]                @relation("UserFrame")
  theme_users         User[]                @relation("UserTheme")
}

model user_milestones {
  id               String     @id
  user_id          String
  milestone_id     String
  current_progress Int        @default(0)
  is_completed     Boolean    @default(false)
  completed_at     DateTime?
  claimed_at       DateTime?
  created_at       DateTime   @default(now())
  updated_at       DateTime
  milestones       milestones @relation(fields: [milestone_id], references: [id])
  users            User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, milestone_id])
}

model user_unlocked_items {
  id           String       @id
  user_id      String
  item_id      String
  unlocked_at  DateTime     @default(now())
  reward_items reward_items @relation(fields: [item_id], references: [item_id])
  users        User         @relation(fields: [user_id], references: [id])

  @@unique([user_id, item_id])
}

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum EducationLevel {
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  UNIVERSITY
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

enum ItemType {
  THEME
  FRAME
}

enum NotificationTypeCode {
  NEW_FOLLOWER
  NEW_LIKE
  NEW_COMMENT
  NEW_POST
  BOOKMARK_REMOVED
  POST_SUSPENDED
  POST_RESTORED
  POST_REMOVED
  POST_REPORTED
  QUEST_COMPLETED
  ACCOUNT_BANNED
  ACCOUNT_UNBANNED
}

enum PostStatus {
  DRAFT
  ACTIVE
  DELETED
  UNACTIVED
}
