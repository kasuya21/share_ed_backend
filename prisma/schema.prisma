generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum EducationLevel {
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  UNIVERSITY
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

enum ItemType {
  THEME
  FRAME
}

enum NotificationTypeCode {
  // Social
  NEW_FOLLOWER
  NEW_LIKE
  NEW_COMMENT
  NEW_POST
  // Bookmark
  BOOKMARK_REMOVED
  // Post moderation
  POST_SUSPENDED
  POST_RESTORED
  POST_REMOVED
  POST_REPORTED
  // Quest / Milestone
  QUEST_COMPLETED
  // Account management
  ACCOUNT_BANNED
  ACCOUNT_UNBANNED
}

enum PostStatus {
  DRAFT
  ACTIVE
  DELETED
  UNACTIVED
}


//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @map("user_id")

  email    String @unique
  username String @unique

  profile_image String?
  bio           String?

  role   Role       @default(MEMBER)
  status UserStatus @default(ACTIVE)

  education_level EducationLevel?
  age             Int?
  social_links    Json?
  wallpaper       String?
  profile_banner  String?

  is_onboarded Boolean @default(false)

  current_theme_id String?
  current_frame_id String?

  current_theme RewardItem? @relation("UserTheme", fields: [current_theme_id], references: [id])
  current_frame RewardItem? @relation("UserFrame", fields: [current_frame_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  posts     Post[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  followers Follow[] @relation("followers")
  following Follow[] @relation("following")

  notifications Notification[]

  unlocked_items UserUnlockedItem[]
  user_milestones UserMilestone[]
  views       PostView[]
  reports     Report[]

  @@index([username])
  @@index([email])
  @@index([role])
  @@map("users")
}

//////////////////////////////////////////////////////
// POSTS
//////////////////////////////////////////////////////

model Post {
  id String @id @default(uuid()) @map("post_id")

  title   String
  summary String
  content String

  post_status PostStatus @default(DRAFT)

  education_level EducationLevel

  view_count     Int @default(0)
  like_count     Int @default(0)
  comment_count  Int @default(0)
  bookmark_count Int @default(0)

  author_id String
  author User @relation(fields: [author_id], references: [id])

  category_id String?
  category Category? @relation(fields: [category_id], references: [id])

  cover_image String?

  media     PostMedia[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  tags      PostTag[]
  views     PostView[]
  reports   Report[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([author_id])
  @@index([education_level])
  @@index([created_at])
  @@index([like_count])
  @@index([view_count])
  @@map("posts")
}

//////////////////////////////////////////////////////
// COMMENTS
//////////////////////////////////////////////////////

model Comment {
  id String @id @default(uuid()) @map("comment_id")

  content String

  user_id String
  post_id String

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([post_id])
  @@index([user_id])
  @@map("comments")
}

//////////////////////////////////////////////////////
// LIKES
//////////////////////////////////////////////////////

model Like {
  id String @id @default(uuid()) @map("like_id")

  user_id String
  post_id String

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
  @@map("likes")
}

//////////////////////////////////////////////////////
// BOOKMARKS
//////////////////////////////////////////////////////

model Bookmark {
  id String @id @default(uuid()) @map("bookmark_id")

  user_id String
  post_id String

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
  @@map("bookmarks")
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id String @id @default(uuid()) @map("category_id")

  name String @unique

  posts Post[]

  @@map("categories")
}

//////////////////////////////////////////////////////
// TAG
//////////////////////////////////////////////////////

model Tag {
  id String @id @default(uuid()) @map("tag_id")

  tag_name String @unique

  posts PostTag[]

  @@map("tags")
}

//////////////////////////////////////////////////////
// POST TAG
//////////////////////////////////////////////////////

model PostTag {
  id String @id @default(uuid())

  post_id String
  tag_id  String

  post Post @relation(fields: [post_id], references: [id])
  tag  Tag  @relation(fields: [tag_id], references: [id])

  @@unique([post_id, tag_id])
  @@map("post_tags")
}

//////////////////////////////////////////////////////
// POST MEDIA
//////////////////////////////////////////////////////

model PostMedia {
  id String @id @default(uuid()) @map("post_media_id")

  media_url  String
  media_type MediaType

  post_id String
  post Post @relation(fields: [post_id], references: [id])

  @@map("post_media")
}

//////////////////////////////////////////////////////
// FOLLOW
//////////////////////////////////////////////////////

model Follow {
  id String @id @default(uuid())

  follower_id String
  following_id String

  follower User @relation("followers", fields: [follower_id], references: [id])
  following User @relation("following", fields: [following_id], references: [id])

  created_at DateTime @default(now())

  @@unique([follower_id, following_id])
  @@index([follower_id])
  @@index([following_id])
  @@map("follows")
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

model Notification {
  id String @id @default(uuid()) @map("notification_id")

  user_id String

  type NotificationTypeCode

  message String

  is_read Boolean @default(false)

  user User @relation(fields: [user_id], references: [id])

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([is_read])
  @@map("notifications")
}

//////////////////////////////////////////////////////
// REWARDS & COSMETICS
//////////////////////////////////////////////////////

model RewardItem {
  id String @id @map("item_id")

  item_name String
  item_type ItemType

  image_url String?

  metadata Json?

  is_active Boolean @default(true)

  unlocked_by UserUnlockedItem[]
  milestones  Milestone[]

  theme_users User[] @relation("UserTheme")
  frame_users User[] @relation("UserFrame")

  @@map("reward_items")
}

model UserUnlockedItem {
  id String @id @default(uuid())

  user_id String
  item_id String

  user User @relation(fields: [user_id], references: [id])
  item RewardItem @relation(fields: [item_id], references: [id])

  unlocked_at DateTime @default(now())

  @@unique([user_id, item_id])
  @@map("user_unlocked_items")
}

//////////////////////////////////////////////////////
// MILESTONES
//////////////////////////////////////////////////////

model Milestone {
  id String @id @default(uuid())

  title String
  description String

  target_value Int
  milestone_type String

  reward_item_id String?
  reward_item RewardItem? @relation(fields: [reward_item_id], references: [id])

  user_milestones UserMilestone[]

  @@map("milestones")
}

model UserMilestone {
  id String @id @default(uuid())

  user_id String
  milestone_id String

  current_progress Int @default(0)
  is_completed Boolean @default(false)

  completed_at DateTime?
  claimed_at DateTime?

  user User @relation(fields: [user_id], references: [id])
  milestone Milestone @relation(fields: [milestone_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, milestone_id])
  @@map("user_milestones")
}

//////////////////////////////////////////////////////
// POST VIEWS
//////////////////////////////////////////////////////

model PostView {
  id String @id @default(uuid()) @map("view_id")

  user_id String
  post_id String

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  viewed_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@map("post_views")
}

//////////////////////////////////////////////////////
// REPORTS
//////////////////////////////////////////////////////

model Report {
  id String @id @default(uuid()) @map("report_id")

  reason String

  user_id String
  post_id String

  user User @relation(fields: [user_id], references: [id])
  post Post @relation(fields: [post_id], references: [id])

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@map("reports")
}
