generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum EducationLevel {
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  UNIVERSITY
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
}

enum StorageProvider {
  CLOUDINARY
  SUPABASE
}

enum ItemType {
  THEME
  FRAME
}

enum NotificationTypeCode {
  // Social
  NEW_FOLLOWER
  NEW_LIKE
  LIKE
  NEW_COMMENT
  NEW_POST

  // Bookmark
  BOOKMARK_REMOVED

  // Post moderation
  POST_SUSPENDED
  POST_RESTORED
  POST_REMOVED
  POST_REPORTED

  // Achievement / Milestone
  ACHIEVEMENT_COMPLETED
  QUEST_COMPLETED

  // Account management
  ACCOUNT_BANNED
  ACCOUNT_UNBANNED
}

enum PostStatus {
  DRAFT
  ACTIVE
  UNACTIVED
}

enum UploadSessionStatus {
  PENDING
  COMMITTED
  EXPIRED
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @map("user_id")

  email    String @unique
  username String @unique

  profile_image String?
  bio           String?

  role   Role       @default(MEMBER)
  status UserStatus @default(ACTIVE)

  education_level EducationLevel?
  social_links    Json?
  wallpaper       String?
  profile_banner  String?

  is_onboarded Boolean @default(false)

  nickname   String?
  location   String?
  occupation String?

  current_theme_id String?
  current_frame_id String?

  // ลบ Theme -> User ยังอยู่
  current_theme RewardItem? @relation("UserTheme", fields: [current_theme_id], references: [id], onDelete: SetNull)

  // ลบ Frame -> User ยังอยู่
  current_frame RewardItem? @relation("UserFrame", fields: [current_frame_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  posts     Post[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  followers Follow[] @relation("followers")
  following Follow[] @relation("following")

  notifications        Notification[] @relation("NotificationRecipient")
  notification_actions Notification[] @relation("NotificationActor")

  unlocked_items    UserUnlockedItem[]
  user_achievements UserAchievement[]
  views             PostView[]
  reports           Report[]
  upload_sessions   UploadSession[]

  @@index([username])
  @@index([email])
  @@index([role])
  @@map("users")
}

//////////////////////////////////////////////////////
// PRIVILEGED ACTION AUDIT
//////////////////////////////////////////////////////

model AdminSecurityAudit {
  id String @id @default(uuid()) @map("audit_id")

  actor_id       String
  target_user_id String

  action String

  old_value String?
  new_value String?

  request_id String?
  ip_address String?

  created_at DateTime @default(now())

  @@index([actor_id, created_at])
  @@index([target_user_id, created_at])
  @@map("admin_security_audits")
}

//////////////////////////////////////////////////////
// POSTS
//////////////////////////////////////////////////////

model Post {
  id String @id @default(uuid()) @map("post_id")

  title   String
  summary String
  content String

  post_status PostStatus @default(DRAFT)

  education_level EducationLevel

  view_count     Int @default(0)
  like_count     Int @default(0)
  comment_count  Int @default(0)
  bookmark_count Int @default(0)

  author_id String

  // HARD DELETE USER -> Posts หายตาม
  author User @relation(fields: [author_id], references: [id], onDelete: Cascade)

  category_id String?

  // ลบ Category -> Post ยังอยู่
  category Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  cover_image     String?
  idempotency_key String?

  media           PostMedia[]
  comments        Comment[]
  likes           Like[]
  bookmarks       Bookmark[]
  tags            PostTag[]
  views           PostView[]
  reports         Report[]
  notifications   Notification[]
  upload_sessions UploadSession[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@unique([author_id, idempotency_key])
  @@index([author_id])
  @@index([education_level])
  @@index([created_at])
  @@index([like_count])
  @@index([view_count])
  @@index([post_status, created_at])
  @@index([post_status, view_count])
  @@map("posts")
}

//////////////////////////////////////////////////////
// UPLOAD SESSION
//////////////////////////////////////////////////////

model UploadSession {
  id String @id @default(uuid()) @map("upload_session_id")

  user_id String

  // ลบ User -> UploadSession หาย
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  post_id String?

  // ลบ Post -> เก็บ Session ไว้ แต่ตัด relation
  post Post? @relation(fields: [post_id], references: [id], onDelete: SetNull)

  status UploadSessionStatus @default(PENDING)

  requested_types Json
  verified_assets Json?

  expires_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, status])
  @@index([status, expires_at])
  @@map("upload_sessions")
}

//////////////////////////////////////////////////////
// COMMENTS
//////////////////////////////////////////////////////

model Comment {
  id String @id @default(uuid()) @map("comment_id")

  content String

  user_id String
  post_id String

  // ลบ User -> Comment หาย
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // ลบ Post -> Comment หาย
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([post_id])
  @@index([user_id])
  @@map("comments")
}

//////////////////////////////////////////////////////
// LIKES
//////////////////////////////////////////////////////

model Like {
  id String @id @default(uuid()) @map("like_id")

  user_id String
  post_id String

  // ลบ User -> Like หาย
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // ลบ Post -> Like หาย
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
  @@map("likes")
}

//////////////////////////////////////////////////////
// BOOKMARKS
//////////////////////////////////////////////////////

model Bookmark {
  id String @id @default(uuid()) @map("bookmark_id")

  user_id String
  post_id String

  // ลบ User -> Bookmark หาย
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // ลบ Post -> Bookmark หาย
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([post_id])
  @@index([user_id])
  @@map("bookmarks")
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id String @id @default(uuid()) @map("category_id")

  name String @unique

  posts Post[]

  @@map("categories")
}

//////////////////////////////////////////////////////
// TAG
//////////////////////////////////////////////////////

model Tag {
  id String @id @default(uuid()) @map("tag_id")

  tag_name String @unique

  posts PostTag[]

  @@map("tags")
}

//////////////////////////////////////////////////////
// POST TAG
//////////////////////////////////////////////////////

model PostTag {
  id String @id @default(uuid())

  post_id String
  tag_id  String

  // ลบ Post -> relation หาย
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  // ลบ Tag -> relation หาย
  tag Tag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([post_id, tag_id])
  @@map("post_tags")
}

//////////////////////////////////////////////////////
// POST MEDIA
//////////////////////////////////////////////////////

model PostMedia {
  id String @id @default(uuid()) @map("post_media_id")

  media_url        String?         @map("media_url")
  media_type       MediaType
  original_name    String?
  storage_provider StorageProvider @default(CLOUDINARY) @map("storage_provider")
  storage_bucket   String?         @map("storage_bucket")
  storage_path     String?         @map("storage_path")
  file_size        Int?            @map("file_size")

  post_id String

  // ลบ Post -> Media record หาย
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@index([storage_provider])
  @@map("post_media")
}

//////////////////////////////////////////////////////
// FOLLOW
//////////////////////////////////////////////////////

model Follow {
  id String @id @default(uuid())

  follower_id  String
  following_id String

  // ลบ follower -> relation หาย
  follower User @relation("followers", fields: [follower_id], references: [id], onDelete: Cascade)

  // ลบ following user -> relation หาย
  following User @relation("following", fields: [following_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([follower_id, following_id])
  @@index([follower_id])
  @@index([following_id])
  @@map("follows")
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

model Notification {
  id String @id @default(uuid()) @map("notification_id")

  user_id String

  type NotificationTypeCode @default(NEW_POST)

  message String

  post_id  String?
  actor_id String?

  is_read Boolean @default(false)

  // ลบเจ้าของ Notification -> Notification หาย
  user User @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)

  // ลบ Actor -> Notification ที่ Actor สร้างไว้หาย
  actor User? @relation("NotificationActor", fields: [actor_id], references: [id], onDelete: Cascade)

  // ลบ Post -> Notification ของ Post นั้นหาย
  post Post? @relation(fields: [post_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([user_id, created_at])
  @@index([actor_id])
  @@index([user_id, actor_id, post_id, type])
  @@index([is_read])
  @@map("notifications")
}

//////////////////////////////////////////////////////
// REWARDS & COSMETICS
//////////////////////////////////////////////////////

model RewardItem {
  id String @id @map("item_id")

  item_name String
  item_type ItemType

  image_url String?

  metadata Json?

  is_active Boolean @default(true)

  unlocked_by UserUnlockedItem[]

  achievements Achievement[]

  theme_users User[] @relation("UserTheme")
  frame_users User[] @relation("UserFrame")

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("reward_items")
}

//////////////////////////////////////////////////////
// USER UNLOCKED ITEMS
//////////////////////////////////////////////////////

model UserUnlockedItem {
  id String @id @default(uuid())

  user_id String
  item_id String

  // ลบ User -> unlocked item หาย
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // ลบ RewardItem -> unlocked relation หาย
  item RewardItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  unlocked_at DateTime @default(now())

  @@unique([user_id, item_id])
  @@map("user_unlocked_items")
}

//////////////////////////////////////////////////////
// ACHIEVEMENTS
//////////////////////////////////////////////////////

model Achievement {
  id String @id @default(uuid())

  title       String
  description String

  target_value     Int
  achievement_type String

  reward_item_id String?

  // ลบ RewardItem -> Achievement ยังอยู่
  reward_item RewardItem? @relation(fields: [reward_item_id], references: [id], onDelete: SetNull)

  user_achievements UserAchievement[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("achievements")
}

//////////////////////////////////////////////////////
// USER ACHIEVEMENTS
//////////////////////////////////////////////////////

model UserAchievement {
  id String @id @default(uuid())

  user_id        String
  achievement_id String

  current_progress Int @default(0)

  is_completed Boolean @default(false)

  completed_at DateTime?
  claimed_at   DateTime?

  // ลบ User -> Achievement progress หาย
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // ลบ Achievement -> Progress ของ Achievement นั้นหาย
  achievement Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, achievement_id])
  @@map("user_achievements")
}

//////////////////////////////////////////////////////
// POST VIEWS
//////////////////////////////////////////////////////

model PostView {
  id String @id @default(uuid()) @map("view_id")

  user_id String
  post_id String

  // ลบ User -> View history หาย
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // ลบ Post -> View history หาย
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  viewed_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@index([viewed_at, post_id])
  @@map("post_views")
}

//////////////////////////////////////////////////////
// REPORTS
//////////////////////////////////////////////////////

model Report {
  id String @id @default(uuid()) @map("report_id")

  reason String

  user_id String
  post_id String

  // ลบ User -> Report ของ User หาย
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // ลบ Post -> Report ของ Post หาย
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([user_id, post_id])
  @@map("reports")
}
